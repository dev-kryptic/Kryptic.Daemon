#!/bin/sh
set -e

wipe_device_keys() {
  u="$1"
  home=$(getent passwd "$u" | cut -d: -f6)
  [ -n "$home" ] || return 0
  rm -f "$home/.config/kryptic/session"
  sudo -u "$u" secret-tool clear service dev.kryptic.daemon account refresh-token 2>/dev/null || true
}

stop_user() {
  u="$1"
  uid=$(id -u "$u") || return 0
  export XDG_RUNTIME_DIR="/run/user/$uid"
  sudo -u "$u" -E systemctl --user disable --now kryptic-daemon 2>/dev/null || true
  pkill -u "$u" -x kryptic-tray 2>/dev/null || true
  pkill -u "$u" -x kryptic 2>/dev/null || true
  wipe_device_keys "$u"
}

if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
  if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    stop_user "$SUDO_USER"
  elif [ -n "${PKEXEC_UID:-}" ] && [ "$PKEXEC_UID" != "0" ]; then
    stop_user "$(id -nu "$PKEXEC_UID")"
  fi
fi

exit 0
