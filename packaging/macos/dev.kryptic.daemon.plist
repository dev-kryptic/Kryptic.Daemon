<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.kryptic.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/kryptic</string>
        <string>start</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if it crashes; launchd throttles restarts on its own. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/kryptic-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/kryptic-daemon.log</string>
</dict>
</plist>
