#!/bin/bash
# After replacing Kryptic.app, put the CLI on PATH and start the new app.
# Do not run `kryptic login`; the Keychain session from the previous install is reused.
set -euo pipefail

APP="/Applications/Kryptic.app"
CLI="${APP}/Contents/MacOS/kryptic"

if [[ -x "${CLI}" ]]; then
  /bin/mkdir -p /usr/local/bin
  /bin/ln -sfn "${CLI}" /usr/local/bin/kryptic
fi

CONSOLE_USER="$(/usr/bin/stat -f %Su /dev/console 2>/dev/null || true)"
if [[ -n "${CONSOLE_USER}" && "${CONSOLE_USER}" != "root" && -d "${APP}" ]]; then
  CONSOLE_UID="$(/usr/bin/id -u "${CONSOLE_USER}")"
  /bin/launchctl asuser "${CONSOLE_UID}" /usr/bin/open "${APP}" >/dev/null 2>&1 || true
fi

exit 0
